# Copy to .env and fill in. Never commit .env.
#
# Generate a strong JWT secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
HOST=127.0.0.1
PORT=5000

MONGO_URL=mongodb://127.0.0.1:27017/orangetraffic

JWT_SECRET=
JWT_EXPIRATION=12h

# Python polling service (SNMP)
HOST_PY=127.0.0.1
PORT_PY=8000

# Checked on the poller's /control/poll endpoint. Required in production —
# there the poller runs with network_mode: host (see backend/docker-compose.yml),
# so this is what stops an unauthenticated caller on the host's network from
# triggering a poll. Generate the same way as JWT_SECRET above.
POLLER_SHARED_SECRET=

# Comma-separated. Leave empty when the API and UI share an origin.
CORS_ORIGINS=http://localhost:4200

# How often the Python poller sweeps every controller (read by both services).
POLL_INTERVAL_SECONDS=60
READING_RETENTION_DAYS=90

# Default SNMP community used for newly-created controllers when none is given.
DEFAULT_SNMP_COMMUNITY=public
